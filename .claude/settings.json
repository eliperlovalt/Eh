{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 tools/build.py:*)",
      "Bash(python3 tools/tests/:*)",
      "Bash(bash tools/tests/gate.sh)",
      "Bash(tools/tests/gate.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
